# syntax=docker/dockerfile:1.7
#
# The web app: the read-only API, serving the built interface.
#
# Two stages, because the interface needs Node to BUILD and nothing to run: the
# first compiles it to static files, the second is the same Python image every
# other service uses, with those files copied in. No Node ships in the result.

ARG BASE_IMAGE=quantlab-base:local

FROM node:22-bookworm-slim AS ui
WORKDIR /ui
# Dependencies first, in their own layer: editing a component must not reinstall them.
# `npm ci` installs exactly what package-lock.json pins, and fails if it has drifted.
COPY ui/package.json ui/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY ui/ ./
RUN npm run build

FROM ${BASE_IMAGE}
COPY --from=ui --chown=quant:quant /ui/dist /app/ui/dist

# The API answers on /api/health without touching the lake, so this checks the
# process, not the data. No curl in the image; Python is already there.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=5)"]

# 0.0.0.0 INSIDE the container, because the port has to be reachable from outside
# it. What keeps the app on this machine is the compose file, which publishes the
# port to 127.0.0.1 only. There is no login: do not publish it any wider.
CMD ["quantlab", "serve", "--host", "0.0.0.0", "--port", "8000"]
