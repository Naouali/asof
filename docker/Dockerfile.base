# syntax=docker/dockerfile:1.7
#
# Shared Python + scientific stack. Every service image builds FROM this.
#
# Multi-architecture by construction (spec section 10): no architecture-specific
# binaries are downloaded, and every dependency is installed from wheels that
# exist for both linux/amd64 and linux/arm64. If a dependency is ever added that
# has no arm64 wheel, the build fails here rather than silently falling back to a
# slow source build on Apple Silicon.

ARG PYTHON_VERSION=3.12
ARG UV_VERSION=0.5.14

# ----------------------------------------------------------------------------------
# builder -- resolve and install dependencies from the committed lockfile
# ----------------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.14 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, in their own layer: editing source must not re-resolve them.
# `--frozen` refuses to update uv.lock, so a build can never silently drift from
# the committed, pinned resolution (spec section 1: reproducible).
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# Then the project itself. uv installs the root project editable, so bind-mounting
# ./src over /app/src in compose gives live code without a rebuild.
COPY README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ----------------------------------------------------------------------------------
# dev -- adds test and lint tooling. Used by `make test`, `make lint`, and CI.
# Kept out of the runtime image so that pytest, mypy and ruff are never shipped
# into a running service.
# ----------------------------------------------------------------------------------
FROM builder AS dev

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    QUANTLAB_ENV=ci \
    QUANTLAB_DATA_ROOT=/tmp/quantlab-data \
    QUANTLAB_REPO_ROOT=/app \
    QUANTLAB_LOG_FORMAT=console

CMD ["pytest"]

# ----------------------------------------------------------------------------------
# runtime -- the image services actually run
# ----------------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ARG UID=1000
ARG GID=1000

# tini reaps zombies and forwards signals, so `docker compose down` stops the
# worker and scheduler promptly instead of waiting out the 10s SIGKILL timeout.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends tini ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid "${GID}" quant; \
    useradd --uid "${UID}" --gid "${GID}" --create-home --shell /bin/bash quant; \
    mkdir -p /data /app; \
    chown -R "${UID}:${GID}" /data /app

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Determinism (spec section 1): unseeded hash randomisation makes set and dict
    # iteration order vary between runs, which is enough to change floating-point
    # reduction order and break byte-identical results.
    PYTHONHASHSEED=0 \
    QUANTLAB_ENV=docker \
    QUANTLAB_DATA_ROOT=/data \
    QUANTLAB_REPO_ROOT=/app \
    QUANTLAB_LOG_FORMAT=json

COPY --from=builder --chown=${UID}:${GID} /app /app

WORKDIR /app
USER quant

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["quantlab", "--help"]
