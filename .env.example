# ---------------------------------------------------------------------------
# QuantLab configuration. Copy to `.env` and edit:  cp .env.example .env
#
# THE STACK RUNS WITH THIS FILE ENTIRELY UNCHANGED. Every API key below is
# optional. Without any key you still have: US Treasury, ECB, Frankfurter FX,
# Stooq, Yahoo, SEC EDGAR fundamentals, Ken French, Open Source Asset Pricing,
# CFTC COT, CBOE and every crypto venue -- enough for the full Tier 1 signal set.
# `quantlab doctor` reports exactly which sources are unavailable and why.
# ---------------------------------------------------------------------------

# --- environment -----------------------------------------------------------
QUANTLAB_LOG_LEVEL=INFO
QUANTLAB_LOG_FORMAT=console

# Refuse all network calls. Set to true once ingest has run, so that research is
# provably reading the lake rather than silently re-fetching.
QUANTLAB_OFFLINE=false

# Seed for every stochastic component. Changing it changes results; that is the
# point of pinning it.
QUANTLAB_RANDOM_SEED=20240101

# --- ingest politeness -----------------------------------------------------
# REQUIRED BEFORE INGESTING SEC EDGAR. The SEC rejects requests that do not
# identify the caller with contact details. Use a real address.
QUANTLAB_HTTP_USER_AGENT=QuantLab/0.1 (your.name@example.com)

# --- API keys (all optional) ------------------------------------------------
# FRED + ALFRED, one key for both. Free: https://fred.stlouisfed.org/docs/api/api_key.html
# Needed for ALL macro and rates work, including ALFRED vintages, which are the
# only way to build a macro signal without look-ahead bias.
QUANTLAB_FRED_API_KEY=

# EIA v2 -- US energy inventories and production. Free: https://www.eia.gov/opendata/register.php
QUANTLAB_EIA_API_KEY=

# USDA NASS QuickStats -- agricultural fundamentals. Free: https://quickstats.nass.usda.gov/api
QUANTLAB_USDA_NASS_API_KEY=

# Cross-validation only; free tiers are far too rate-limited for bulk ingest.
QUANTLAB_NASDAQ_DATA_LINK_API_KEY=
QUANTLAB_ALPHA_VANTAGE_API_KEY=
QUANTLAB_TIINGO_API_KEY=
QUANTLAB_FMP_API_KEY=

# --- database (paper-trading state and run registry only) -------------------
# Bulk market data lives in the parquet lake, never here.
QUANTLAB_POSTGRES_USER=quantlab
QUANTLAB_POSTGRES_PASSWORD=quantlab
QUANTLAB_POSTGRES_DB=quantlab

# --- host-side compose settings --------------------------------------------
# Port the dashboard and Jupyter bind on the host.
QUANTLAB_DASHBOARD_PORT=8080
QUANTLAB_JUPYTER_PORT=8888
# Host uid/gid the container user is mapped to, so files written into bind
# mounts are owned by you rather than by root. On Linux set these to `id -u`/`id -g`.
QUANTLAB_UID=1000
QUANTLAB_GID=1000
